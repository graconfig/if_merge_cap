# ───────────────────────────────────────────────────────────────
# MTA 拡張ディスクリプタ（雛形）。env 方式では凭证は mta.yaml に明文で入っているため必須ではない。
# 環境ごとに値を変えたい場合のみ、ここで上書きする：
#   cp ifmerge-secrets.mtaext.example ifmerge.mtaext   # 編集後
#   cf deploy mta_archives/ifmerge-cap_1.0.0.mtar -e ifmerge.mtaext
# ───────────────────────────────────────────────────────────────
_schema-version: "3.3.0"
ID: ifmerge-cap.ext
extends: ifmerge-cap

parameters:
  # 環境別に変える場合のみ指定（既定は mta.yaml）
  ai-model-name: "claude-4.6-sonnet"
  ai-resource-group: "default"
  # ai-auth-url / ai-base-url / ai-client-id / ai-client-secret も上書き可
